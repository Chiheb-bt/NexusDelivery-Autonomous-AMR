<?xml version="1.0"?>
<robot name="rdsim" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================================== -->
  <!-- Robot Dimensions & Kinematic Constants                         -->
  <!-- ============================================================== -->
  <xacro:property name="base_width" value="0.62"/>
  <xacro:property name="base_length" value="0.82"/>
  <xacro:property name="base_height" value="0.22"/>

  <xacro:property name="wheel_radius" value="0.20"/>
  <xacro:property name="wheel_width" value="0.11"/>
  <xacro:property name="wheel_ygap" value="0.05"/>
  <xacro:property name="wheel_zoff" value="0.10"/>
  <xacro:property name="wheel_xoff" value="0.24"/>

  <!-- ============================================================== -->
  <!-- Standard Materials for RViz / Visualization                     -->
  <!-- ============================================================== -->
  <material name="ChassisWhite">
    <color rgba="0.92 0.93 0.96 1.0"/>
  </material>
  <material name="TrimBlack">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="BumperBlack">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="DarkGrey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="TireRubber">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="RimSilver">
    <color rgba="0.75 0.76 0.80 1.0"/>
  </material>
  <material name="EstopRed">
    <color rgba="0.90 0.08 0.08 1.0"/>
  </material>
  <material name="EstopYellow">
    <color rgba="0.95 0.82 0.05 1.0"/>
  </material>
  <material name="HeadlightLed">
    <color rgba="0.95 0.98 1.00 1.0"/>
  </material>
  <material name="TaillightLed">
    <color rgba="0.95 0.05 0.05 1.0"/>
  </material>
  <material name="AutonomousCyan">
    <color rgba="0.00 0.85 0.95 1.0"/>
  </material>
  <material name="StatusGreen">
    <color rgba="0.08 0.92 0.20 1.0"/>
  </material>
  <material name="AmberGlow">
    <color rgba="1.00 0.76 0.02 1.0"/>
  </material>
  <material name="GlassLens">
    <color rgba="0.05 0.05 0.08 1.0"/>
  </material>

  <!-- ============================================================== -->
  <!-- Inertial Macros                                                -->
  <!-- ============================================================== -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Robot Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${-1 * wheel_xoff} 0.0 ${(wheel_radius+wheel_zoff)}" rpy="0 0 0"/>
  </joint>

  <!-- Main Structural Chassis Frame -->
  <link name="base_link">
    <!-- Visual: Lower structural foundation -->
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width - 0.08} ${base_height}"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Collision Geometry: Robust single bounding envelope for ODE physics -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width - 0.08} ${base_height + 0.06}"/>
      </geometry>
    </collision>

    <!-- Realistic physical mass with low center-of-gravity for rollover stability -->
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="22.0"/>
      <inertia ixx="0.65" ixy="0.0" ixz="0.0"
               iyy="1.30" iyz="0.0"
               izz="1.70"/>
    </inertial>
  </link>

  <!-- ============================================================== -->
  <!-- Enclosed Weather-Resistant Upper Chassis Shell                 -->
  <!-- ============================================================== -->
  <!-- ============================================================== -->
  <!-- Enclosed Weather-Resistant Upper Chassis Shell (Livery Styled)  -->
  <!-- ============================================================== -->
  <link name="chassis_shell_link">
    <!-- Main upper enclosure (Pearl White IP65 automotive body shell) -->
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.76 0.52 0.18"/>
      </geometry>
      <material name="ChassisWhite"/>
    </visual>

    <!-- Aerodynamic front hood contour -->
    <visual>
      <origin xyz="0.28 0 0.04" rpy="0 0.22 0"/>
      <geometry>
        <box size="0.22 0.50 0.12"/>
      </geometry>
      <material name="ChassisWhite"/>
    </visual>

    <!-- Recessed Front RealSense Visor Mask (Gloss Black) -->
    <visual>
      <origin xyz="0.385 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.42 0.055"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Dual Horizontal Status LED Bar Above Visor (Red Left, Green Right) -->
    <!-- Left Status LED: Red Warning / Alert Indicator -->
    <visual>
      <origin xyz="0.388 0.11 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.14 0.018"/>
      </geometry>
      <material name="EstopRed"/>
    </visual>
    <!-- Right Status LED: Green Operational / Delivery Indicator -->
    <visual>
      <origin xyz="0.388 -0.11 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.14 0.018"/>
      </geometry>
      <material name="StatusGreen"/>
    </visual>
    <!-- Status LED Bezel Frame -->
    <visual>
      <origin xyz="0.386 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.40 0.024"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Front Hood Branding Plate: CHIHEB_BOT -->
    <visual>
      <origin xyz="0.392 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.36 0.050"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>
    <visual>
      <origin xyz="0.395 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.34 0.038"/>
      </geometry>
      <material name="ChassisWhite"/>
    </visual>
    <!-- Central Brand Name Inscription Bar -->
    <visual>
      <origin xyz="0.397 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.30 0.018"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Cyan Illuminated Status Strips (Left & Right Waistlines) -->
    <visual>
      <origin xyz="0 0.262 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.012 0.016"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>
    <visual>
      <origin xyz="0 -0.262 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.012 0.016"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>

    <!-- Tall Safety Beacon Mast & Amber Flashing Dome (As in Reference Picture) -->
    <!-- Vertical Black Antenna Mast -->
    <visual>
      <origin xyz="-0.28 0.21 0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.52"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>
    <!-- Mast Collar Base Mount -->
    <visual>
      <origin xyz="-0.28 0.21 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.040"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
    <!-- Amber Glowing Flashing Beacon Lamp on Top of Mast -->
    <visual>
      <origin xyz="-0.28 0.21 0.56" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.044" length="0.065"/>
      </geometry>
      <material name="AmberGlow"/>
    </visual>
    <!-- Beacon Crown Cap -->
    <visual>
      <origin xyz="-0.28 0.21 0.595" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.012"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Side protective rocker panel trims (Matte Black) -->
    <visual>
      <origin xyz="0 0.25 -0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.74 0.03 0.08"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>
    <visual>
      <origin xyz="0 -0.25 -0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.74 0.03 0.08"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="chassis_shell_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_shell_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Hollow Cargo Bay Cavity (Parcel Placement Storage)             -->
  <!-- ============================================================== -->
  <link name="cargo_bay_link">
    <!-- Interior recessed cargo compartment tub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.40 0.12"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="cargo_bay_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cargo_bay_link"/>
    <origin xyz="-0.04 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Vertical Cargo Lift Mechanism (Lead Screw / Linear Actuator)    -->
  <!-- ============================================================== -->
  <link name="cargo_platform_link">
    <!-- Anodized aircraft-grade aluminum elevator carriage plate -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.36 0.015"/>
      </geometry>
      <material name="RimSilver"/>
    </visual>

    <!-- High-grip textured rubber retention mat -->
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.34 0.34 0.003"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Cargo retention guide rail lip (front) -->
    <visual>
      <origin xyz="0.17 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.34 0.02"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>

    <!-- Cargo retention guide rail lip (rear) -->
    <visual>
      <origin xyz="-0.17 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.34 0.02"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.36 0.015"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.50"/>
      <inertia ixx="0.016" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.032"/>
    </inertial>
  </link>

  <!-- Prismatic Vertical Lift: 0.0m = Stowed (Deep Bay), 0.12m = Raised (Threshold Handover) -->
  <joint name="cargo_lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="cargo_platform_link"/>
    <origin xyz="-0.04 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.12" effort="300.0" velocity="0.05"/>
    <dynamics damping="10.0" friction="1.0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Motorized 60-Degree Cargo Delivery Hatch                       -->
  <!-- ============================================================== -->
  <link name="cargo_hatch_link">
    <!-- Motorized delivery hatch lid panel (pivots from rear hinge) -->
    <visual>
      <origin xyz="0.22 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.44 0.025"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Perimeter weatherproof silicone seal gasket -->
    <visual>
      <origin xyz="0.22 0 -0.002" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.46 0.008"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>

    <!-- Customer interface panel / NFC-RFID badge unlock pad -->
    <visual>
      <origin xyz="0.40 0 0.026" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.16 0.006"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>

    <!-- Recessed hatch latch handle -->
    <visual>
      <origin xyz="0.05 0 0.026" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.12 0.006"/>
      </geometry>
      <material name="RimSilver"/>
    </visual>

    <collision>
      <origin xyz="0.22 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.44 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.22 0 0.012" rpy="0 0 0"/>
      <mass value="0.50"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.016"/>
    </inertial>
  </link>

  <!-- Revolute Hinge: 0.0 rad = Closed, 1.05 rad (~60 deg) = Open -->
  <joint name="cargo_hatch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="cargo_hatch_link"/>
    <origin xyz="-0.26 0 0.165" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="1.05" effort="50.0" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Battery and Electronics Bay                                    -->
  <!-- ============================================================== -->
  <link name="battery_bay_link">
    <!-- Lower sealed battery tray (LiFePO4 modular pack) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.52 0.38 0.07"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Left side cooling louvers / ventilation grill -->
    <visual>
      <origin xyz="0 0.195 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.01 0.045"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>

    <!-- Right side cooling louvers / ventilation grill -->
    <visual>
      <origin xyz="0 -0.195 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.01 0.045"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="battery_bay_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_bay_link"/>
    <origin xyz="0 0 -0.11" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Protective Front & Rear Bumpers                                -->
  <!-- ============================================================== -->
  <link name="bumper_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.58 0.12"/>
      </geometry>
      <material name="BumperBlack"/>
    </visual>
    <!-- Left corner deflector wing -->
    <visual>
      <origin xyz="-0.03 0.28 0" rpy="0 0 0.45"/>
      <geometry>
        <box size="0.07 0.08 0.12"/>
      </geometry>
      <material name="BumperBlack"/>
    </visual>
    <!-- Right corner deflector wing -->
    <visual>
      <origin xyz="-0.03 -0.28 0" rpy="0 0 -0.45"/>
      <geometry>
        <box size="0.07 0.08 0.12"/>
      </geometry>
      <material name="BumperBlack"/>
    </visual>

    <!-- Lower Driving Headlights (Bright White LEDs) -->
    <visual>
      <origin xyz="0.042 0.22 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.048 0.028"/>
      </geometry>
      <material name="HeadlightLed"/>
    </visual>
    <visual>
      <origin xyz="0.042 -0.22 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.048 0.028"/>
      </geometry>
      <material name="HeadlightLed"/>
    </visual>

    <!-- Mini Front Status Marker Dots (Green & Red) -->
    <visual>
      <origin xyz="0.043 0.11 -0.025" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.006"/>
      </geometry>
      <material name="StatusGreen"/>
    </visual>
    <visual>
      <origin xyz="0.043 -0.11 -0.025" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.006"/>
      </geometry>
      <material name="EstopRed"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.58 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="bumper_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_front_link"/>
    <origin xyz="0.43 0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="bumper_rear_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.58 0.12"/>
      </geometry>
      <material name="BumperBlack"/>
    </visual>
    <visual>
      <origin xyz="-0.03 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.38 0.02"/>
      </geometry>
      <material name="RimSilver"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.58 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="bumper_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_rear_link"/>
    <origin xyz="-0.43 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Emergency Stop (E-Stop) Button                                 -->
  <!-- ============================================================== -->
  <link name="estop_base_link">
    <!-- Safety yellow bezel base ring -->
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.012"/>
      </geometry>
      <material name="EstopYellow"/>
    </visual>

    <!-- Crimson red mushroom push button head -->
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.020"/>
      </geometry>
      <material name="EstopRed"/>
    </visual>

    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="estop_joint" type="fixed">
    <parent link="base_link"/>
    <child link="estop_base_link"/>
    <origin xyz="-0.30 0.18 0.165" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Status & Safety Lighting                                       -->
  <!-- ============================================================== -->
  <!-- Front Headlights (High-visibility driving lights) -->
  <link name="headlights_link">
    <visual>
      <origin xyz="0 0.18 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.12 0.025"/>
      </geometry>
      <material name="HeadlightLed"/>
    </visual>
    <visual>
      <origin xyz="0 -0.18 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.12 0.025"/>
      </geometry>
      <material name="HeadlightLed"/>
    </visual>

    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="headlights_joint" type="fixed">
    <parent link="base_link"/>
    <child link="headlights_link"/>
    <origin xyz="0.42 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Rear Taillights / Brake Light Strip -->
  <link name="taillights_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.44 0.025"/>
      </geometry>
      <material name="TaillightLed"/>
    </visual>

    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="taillights_joint" type="fixed">
    <parent link="base_link"/>
    <child link="taillights_link"/>
    <origin xyz="-0.42 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Autonomous Operational State Indicator Beacons (Cyan Rings) -->
  <link name="beacon_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.028"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="beacon_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="beacon_left_link"/>
    <origin xyz="0.22 0.22 0.17" rpy="0 0 0"/>
  </joint>

  <link name="beacon_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.028"/>
      </geometry>
      <material name="AutonomousCyan"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="beacon_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="beacon_right_link"/>
    <origin xyz="0.22 -0.22 0.17" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!-- Four Visibly Realistic Wheels Macro                            -->
  <!-- ============================================================== -->
  <xacro:macro name="delivery_wheel" params="name x_pos y_pos">
    <link name="${name}_link">
      <!-- Outer rugged rubber tread -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="TireRubber"/>
      </visual>

      <!-- Rugged Off-Road Shoulder Tread Ribs -->
      <visual>
        <origin xyz="0 ${wheel_width * 0.35} 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 1.015}" length="${wheel_width * 0.25}"/>
        </geometry>
        <material name="BumperBlack"/>
      </visual>
      <visual>
        <origin xyz="0 ${-wheel_width * 0.35} 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 1.015}" length="${wheel_width * 0.25}"/>
        </geometry>
        <material name="BumperBlack"/>
      </visual>

      <!-- Inner alloy rim / metallic wheel spokes -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.68}" length="${wheel_width + 0.004}"/>
        </geometry>
        <material name="RimSilver"/>
      </visual>

      <!-- Central hubcap and lug pattern -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.28}" length="${wheel_width + 0.008}"/>
        </geometry>
        <material name="TrimBlack"/>
      </visual>

      <!-- Accurate physical collision cylinder -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Wheel mass and polar inertia -->
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="1.2"/>
        <inertia ixx="0.0126" ixy="0" ixz="0"
                 iyy="${(1.2/2) * (wheel_radius*wheel_radius)}" iyz="0"
                 izz="0.0126"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x_pos} ${y_pos} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Front Active Drive Wheels -->
  <xacro:delivery_wheel name="wheel_left"  x_pos="${wheel_xoff}" y_pos="${1*(base_width/2+wheel_ygap)}"/>
  <xacro:delivery_wheel name="wheel_right" x_pos="${wheel_xoff}" y_pos="${-1*(base_width/2+wheel_ygap)}"/>

  <!-- Rear Continuous Rolling Wheels (Passive low-friction for smooth differential turning) -->
  <xacro:delivery_wheel name="wheel_rear_left"  x_pos="${-wheel_xoff}" y_pos="${1*(base_width/2+wheel_ygap)}"/>
  <xacro:delivery_wheel name="wheel_rear_right" x_pos="${-wheel_xoff}" y_pos="${-1*(base_width/2+wheel_ygap)}"/>

  <!-- ============================================================== -->
  <!-- Sensors: RGB-D Camera, IMU, GPS                                -->
  <!-- ============================================================== -->
  <!-- Front RGB-D Camera (Stereo IR + RGB Lens Assembly) -->
  <link name="camera_link">
    <!-- Camera Sensor Enclosure (RealSense / OAK-D form factor) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.125 0.028"/>
      </geometry>
      <material name="TrimBlack"/>
    </visual>

    <!-- Front Optical Bezel Faceplate -->
    <visual>
      <origin xyz="0.013 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.120 0.024"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>

    <!-- Left IR Projector Aperture -->
    <visual>
      <origin xyz="0.014 0.045 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.003"/>
      </geometry>
      <material name="GlassLens"/>
    </visual>

    <!-- Center RGB Camera Lens -->
    <visual>
      <origin xyz="0.014 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.003"/>
      </geometry>
      <material name="GlassLens"/>
    </visual>

    <!-- Right IR Emitter Aperture -->
    <visual>
      <origin xyz="0.014 -0.045 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.003"/>
      </geometry>
      <material name="GlassLens"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.125 0.028"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- Camera joint origin calibrated at 0.42m above ground level (mounted on front hood fascia) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.44 0 0.12" rpy="0 0.05 0"/>
  </joint>

  <!-- GPS Link (isolated to evaluation / ground truth) -->
  <link name="gps_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- IMU Link -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Plugins and Physical Surface Properties -->
  <xacro:include filename="$(find rdsim_description)/urdf/rdsim.camera_only.gazebo.xacro" />

</robot>
