<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="nexus_package">
    <pose>0 0 0.07 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.80</mass>
        <inertia>
          <ixx>0.0065</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
