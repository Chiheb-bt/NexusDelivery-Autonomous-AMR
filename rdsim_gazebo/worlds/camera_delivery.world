<?xml version="1.0"?>
<sdf version="1.6">
  <world name="camera_delivery">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="track_surface">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry><box><size>50 6 0.1</size></box></geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>
        <visual name="road">
          <geometry><box><size>50 6 0.1</size></box></geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.16 0.16 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="line">
          <geometry><box><size>50 0.08 0.006</size></box></geometry>
          <pose>0 0 0.003 0 0 0</pose>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="signal_post">
      <static>true</static>
      <pose>-0.5 0.65 0.8 0 0 0</pose>
      <link name="post">
        <visual name="post_visual">
          <geometry><box><size>0.08 0.08 1.6</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="post_collision">
          <geometry><box><size>0.08 0.08 1.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="tl_red_on">
      <pose>-0.5 0.65 1.15 0 0 0</pose>
      <link name="lamp">
        <gravity>false</gravity>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="red_lamp">
          <geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.8 0 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="tl_green_on">
      <pose>-0.5 0.65 -5 0 0 0</pose>
      <link name="lamp">
        <gravity>false</gravity>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="green_lamp">
          <geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 0.8 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="orange_obstacle">
      <pose>3.0 0 0.22 0 0 0</pose>
      <link name="body">
        <inertial><mass>2</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.35 0.45 0.44</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.45 0.44</size></box></geometry>
          <material><ambient>1 0.24 0.02 1</ambient><diffuse>1 0.24 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>